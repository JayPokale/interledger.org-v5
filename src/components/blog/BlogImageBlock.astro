---
/**
 * ImageBlock for blog posts: no block frame, so a post keeps the plain prose
 * rhythm around its images (ADR-009 D3 keeps the blog out of scope).
 */
import type { ComponentProps } from 'astro/types'
import ImageBlock from '@/components/blocks/ImageBlock.astro'

type Props = Omit<ComponentProps<typeof ImageBlock>, 'bare'>
---

<ImageBlock {...Astro.props} bare />
