---
/**
 * Quote for blog posts: no block frame, so a post keeps the plain prose
 * rhythm around its quotes (ADR-009 D3 keeps the blog out of scope).
 */
import type { ComponentProps } from 'astro/types'
import Quote from '@/components/blocks/Quote.astro'

type Props = Omit<ComponentProps<typeof Quote>, 'bare'>
---

<Quote {...Astro.props} bare><slot /></Quote>
